{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eurobotics-association.github.io/barba-cv/schema/barba-cv-1.3.schema.json",
  "title": "Barba-CV 1.3 schema",
  "description": "Barba-CV 1.3 payload contract. Only barba_cv_version is required at the root; other fields are optional unless a nested requirement is stated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "barba_cv_version"
  ],
  "properties": {
    "barba_cv_version": {
      "const": "1.3",
      "description": "Exact payload format declaration."
    },
    "personal_info": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "first_name": {
          "type": "string",
          "description": "Given name."
        },
        "middle_name": {
          "type": "string",
          "description": "Middle name; renamed from 1.0 `Middle_name`."
        },
        "last_name": {
          "type": "string",
          "description": "Family name."
        },
        "date_of_birth": {
          "type": "string",
          "description": "Birth date as supplied; no date format required."
        },
        "driving_licenses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Licences stated by the source."
        },
        "address": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "street": {
              "type": "string",
              "description": "Street address line."
            },
            "street2": {
              "type": "string",
              "description": "Optional second address line; restored from 1.0."
            },
            "postal_code": {
              "type": "string",
              "description": "Postal code as text; no country format required."
            },
            "city": {
              "type": "string",
              "description": "Address city."
            },
            "country": {
              "type": "string",
              "description": "Address country."
            }
          },
          "description": "Address."
        },
        "contact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "email": {
              "type": "string",
              "description": "Email address as supplied."
            },
            "phone": {
              "type": "string",
              "description": "Telephone number as supplied."
            }
          },
          "description": "Contact."
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "linkedin": {
              "type": "string",
              "description": "LinkedIn link."
            },
            "github": {
              "type": "string",
              "description": "GitHub link."
            },
            "website": {
              "type": "string",
              "description": "Personal website."
            },
            "twitter": {
              "type": "string",
              "description": "X/Twitter link; canonical name since 1.2."
            },
            "instagram": {
              "type": "string",
              "description": "Instagram link; restored from 1.0."
            },
            "facebook": {
              "type": "string",
              "description": "Facebook link; restored from 1.0."
            },
            "other_socials": {
              "type": "array",
              "description": "Legacy list of other social links; item shape remains unspecified."
            }
          },
          "description": "Social links as supplied; do not fabricate URLs."
        }
      },
      "description": "Candidate identity and contact details."
    },
    "profile_summary": {
      "type": "string",
      "description": "Source-backed summary, in human wording."
    },
    "position_sought": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Desired roles or positioning statements."
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "organization": {
            "type": "string",
            "description": "Employer or organization name."
          },
          "role_title": {
            "type": "string",
            "description": "Role or job title."
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "city": {
                "type": "string",
                "description": "Work city."
              },
              "country": {
                "type": "string",
                "description": "Work country."
              }
            },
            "description": "Work location when structured parts are known."
          },
          "start_date": {
            "type": "string",
            "description": "Start wording from the source."
          },
          "end_date": {
            "type": "string",
            "description": "End wording from the source."
          },
          "website": {
            "type": "string",
            "description": "Organization or role website."
          },
          "logo": {
            "type": "string",
            "description": "Logo reference if supplied."
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Responsibilities or tasks, one text item each."
          },
          "achievements": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Achievement statements, one text item each."
          }
        },
        "description": "One professional experience entry; include only details supported by the source CV."
      },
      "description": "Professional experience entries."
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "school": {
            "type": "string",
            "description": "School or institution."
          },
          "degree": {
            "type": "string",
            "description": "Qualification or degree."
          },
          "field": {
            "type": "string",
            "description": "Field of study."
          },
          "start_date": {
            "type": "string",
            "description": "Start wording from the source."
          },
          "end_date": {
            "type": "string",
            "description": "End wording from the source."
          },
          "website": {
            "type": "string",
            "description": "Institution website."
          },
          "logo": {
            "type": "string",
            "description": "Logo reference if supplied."
          },
          "school_location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "city": {
                "type": "string",
                "description": "School city."
              },
              "country": {
                "type": "string",
                "description": "School country."
              }
            },
            "description": "City/country object; older text cannot always be split."
          }
        },
        "description": "One education entry; preserve the institution and qualification wording supplied by the source."
      },
      "description": "Education entries."
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "it_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty source skill label; required when item exists."
              },
              "level": {
                "type": "string",
                "description": "Source-backed human-readable proficiency; no fixed scale."
              },
              "category": {
                "type": "string",
                "description": "Source-backed subcategory within the outer bucket."
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Source-backed related terms; no inferred aliases."
              }
            },
            "description": "Skill object; simple entries need only `name`.",
            "required": [
              "name"
            ]
          },
          "description": "IT-related skills."
        },
        "hard_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty source skill label; required when item exists."
              },
              "level": {
                "type": "string",
                "description": "Source-backed human-readable proficiency; no fixed scale."
              },
              "category": {
                "type": "string",
                "description": "Source-backed subcategory within the outer bucket."
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Source-backed related terms; no inferred aliases."
              }
            },
            "description": "Skill object; simple entries need only `name`.",
            "required": [
              "name"
            ]
          },
          "description": "Other technical or domain skills."
        },
        "soft_skills": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "description": "Nonempty source skill label; required when item exists."
              },
              "level": {
                "type": "string",
                "description": "Source-backed human-readable proficiency; no fixed scale."
              },
              "category": {
                "type": "string",
                "description": "Source-backed subcategory within the outer bucket."
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Source-backed related terms; no inferred aliases."
              }
            },
            "description": "Skill object; simple entries need only `name`.",
            "required": [
              "name"
            ]
          },
          "description": "Interpersonal or transferable skills."
        }
      },
      "description": "Three established skill buckets."
    },
    "certifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Certification name."
          },
          "issuer": {
            "type": "string",
            "description": "Issuing organization."
          },
          "date_obtained": {
            "type": "string",
            "description": "Date wording from the source."
          },
          "expiry_date": {
            "type": "string",
            "description": "Expiry wording from the source."
          },
          "credential_id": {
            "type": "string",
            "description": "Credential identifier."
          },
          "credential_url": {
            "type": "string",
            "description": "Credential URL."
          }
        },
        "description": "One certification or credential; fields may be absent when the source does not supply them."
      },
      "description": "Certifications or credentials stated in the source CV."
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "language": {
            "type": "string",
            "description": "Language name."
          },
          "level": {
            "type": "string",
            "description": "Source-backed proficiency wording."
          },
          "certificates": {
            "type": "array",
            "description": "Legacy list of certificates; item shape remains unspecified."
          }
        },
        "description": "One language spoken by the person, with optional source-backed proficiency and certificates."
      },
      "description": "Language entries."
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Personal interests or activities stated in the source CV; remains a root section."
    },
    "project_achievements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Project identifier if supplied."
          },
          "service_type": {
            "type": "string",
            "description": "Service or work type."
          },
          "client": {
            "type": "string",
            "description": "Client or beneficiary."
          },
          "title": {
            "type": "string",
            "description": "Project title."
          },
          "period": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "start": {
                "type": "string",
                "description": "Start wording."
              },
              "end": {
                "type": "string",
                "description": "End wording."
              }
            },
            "description": "Human-readable start/end object; older free text may not split."
          },
          "role": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One or more role labels."
          },
          "sectors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One or more sector labels."
          },
          "competencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One or more competency labels."
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "One or more source-backed terms."
          },
          "description": {
            "type": "string",
            "description": "Project description."
          },
          "synonyms": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional open object; internal structure is not standardized. Preserve supplied data."
          }
        },
        "description": "One project or achievement entry described in the source CV."
      },
      "description": "Projects or achievements described in the CV."
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cv_uuid": {
          "type": [
            "string",
            "null"
          ],
          "description": "System-assigned CV identifier, separate from the display title and original filename; UUID syntax is not currently enforced."
        },
        "cv_title": {
          "type": [
            "string",
            "null"
          ],
          "description": "User-facing title or label for this CV, supplied by a user or producer; separate from its original filename and system identifier."
        },
        "content_language": {
          "type": "string",
          "minLength": 1,
          "description": "Likely predominant language of human-readable CV values, preferably a BCP 47 language tag; may be user- or parser-declared. It does not assert that every field has that language or translate values. Omit if unknown."
        },
        "parsing_errors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recorded extraction or mapping diagnostic messages; moved from the 1.0 root. Empty means no errors recorded, not guaranteed extraction accuracy."
        },
        "ats_processed": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Whether ATS-oriented processing is known to have occurred."
        },
        "processor_engine": {
          "type": [
            "string",
            "null"
          ],
          "description": "Software or system that produced this structured CV, optionally including its version in the same value; this is the system parser/creator, not a human author."
        },
        "parsed_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "Parse timestamp in source/system wording."
        },
        "source_original_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "Original extracted text if retained."
        },
        "source_ats_revised_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "ATS-oriented revised text if retained."
        },
        "original_filename": {
          "type": [
            "string",
            "null"
          ],
          "description": "Filename of the document parsed to create this CV data; not the user-facing CV title or system identifier."
        },
        "source_format": {
          "type": [
            "string",
            "null"
          ],
          "description": "Source file format."
        },
        "ingested_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "Ingestion timestamp."
        },
        "embedded_at": {
          "type": [
            "string",
            "null"
          ],
          "description": "Embedding timestamp."
        },
        "extraction_confidence_overall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1,
          "description": "Optional numeric confidence from 0 to 1."
        }
      },
      "description": "Processing provenance and diagnostics, not biographical facts."
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Adopter-specific data; unknown JSON values preserved on pass-through."
    }
  }
}
